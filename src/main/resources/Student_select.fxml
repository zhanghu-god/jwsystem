<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Student_selectCon">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <TableView prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="courseid" prefWidth="75.0" text="课程编号" />
                <TableColumn fx:id="coursename" prefWidth="75.0" text="课程名称" />
                  <TableColumn fx:id="teachername" prefWidth="75.0" text="教师名称" />
                  <TableColumn fx:id="time" prefWidth="75.0" text="时间" />
                  <TableColumn fx:id="classroom" prefWidth="75.0" text="教室" />
              </columns>
            </TableView>
         </center>
         <right>
            <VBox prefHeight="400.0" prefWidth="224.0" spacing="40.0" BorderPane.alignment="CENTER">
               <children>
                  <Label prefHeight="35.0" prefWidth="179.0" text="           操作区">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="添加课程：" />
                  <Label text="输入课程编号：" />
                  <TextField fx:id="inputid" promptText="输入课程编号" />
                  <Button fx:id="confirm" mnemonicParsing="false" onAction="#select" text="确认选课">
                     <VBox.margin>
                        <Insets left="120.0" />
                     </VBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets left="20.0" top="20.0" />
               </padding>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
