<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Teacher_courseinfoCon">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <TableView prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="courseid" prefWidth="75.0" text="课程编号" />
                <TableColumn fx:id="coursename" prefWidth="75.0" text="名称" />
                  <TableColumn fx:id="time" prefWidth="75.0" text="上课时间" />
                  <TableColumn fx:id="classroom" prefWidth="75.0" text="教室" />
              </columns>
            </TableView>
         </center>
         <right>
            <VBox prefHeight="400.0" prefWidth="247.0" spacing="13.0" BorderPane.alignment="CENTER">
               <children>
                  <Label prefHeight="35.0" prefWidth="179.0" text="            操作区">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label layoutX="10.0" layoutY="10.0" text="添加课程" />
                  <HBox prefHeight="30.0" prefWidth="198.0" spacing="10.0">
                     <children>
                        <Label text="课程编号" />
                        <TextField fx:id="inputid" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="40.0" prefHeight="30.0" prefWidth="198.0" spacing="10.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="47.0" text="     名称" />
                        <TextField fx:id="inputname" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="40.0" prefHeight="30.0" prefWidth="198.0" spacing="9.0">
                     <children>
                        <Label text="上课时间" />
                        <TextField fx:id="inputname" />
                     </children>
                  </HBox>
                  <HBox layoutX="35.0" layoutY="129.0" prefHeight="30.0" prefWidth="198.0" spacing="10.0">
                     <children>
                        <Label prefHeight="18.0" prefWidth="47.0" text="     教室" />
                        <TextField fx:id="inputclassroom" />
                     </children>
                  </HBox>
                  <Button fx:id="addbtn" mnemonicParsing="false" onAction="#add" prefWidth="64.0" text="添加" />
                  <Button fx:id="delbtn" layoutX="10.0" layoutY="387.0" mnemonicParsing="false" onAction="#del" prefWidth="64.0" text="删除" />
                  <Button fx:id="refreshbtn" layoutX="10.0" layoutY="387.0" mnemonicParsing="false" onAction="#refresh" prefWidth="64.0" text="刷新" />
               </children>
               <padding>
                  <Insets left="25.0" />
               </padding>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
