<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Admin_stuinfoController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <TableView fx:id="tableview" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="stuid" prefWidth="75.0" text="学号" />
                <TableColumn fx:id="stuname" prefWidth="75.0" text="姓名" />
                  <TableColumn fx:id="password" prefWidth="75.0" text="密码" visible="false" />
              </columns>
            </TableView>
         </center>
         <right>
            <VBox prefHeight="400.0" prefWidth="226.0" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Label prefHeight="35.0" prefWidth="179.0" text="           操作区">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="添加学生：" />
                  <HBox prefHeight="45.0" prefWidth="241.0" spacing="10.0">
                     <children>
                        <Label text="学号" />
                        <TextField fx:id="inputid" />
                     </children>
                  </HBox>
                  <HBox prefHeight="40.0" prefWidth="189.0" spacing="10.0">
                     <children>
                        <Label text="姓名" />
                        <TextField fx:id="inputname" />
                     </children>
                  </HBox>
                  <Button fx:id="addbtn" mnemonicParsing="false" onAction="#add" prefHeight="23.0" prefWidth="64.0" text="添加" />
                  <Button fx:id="delbtn" mnemonicParsing="false" onAction="#del" prefHeight="23.0" prefWidth="64.0" text="删除" />
                  <Button fx:id="refreshbtn" mnemonicParsing="false" onAction="#refresh" prefHeight="23.0" prefWidth="64.0" text="刷新" />
               </children>
               <padding>
                  <Insets left="25.0" top="20.0" />
               </padding>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
