<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Admin_couinfoController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <TableView fx:id="tableview" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="courseid" prefWidth="75.0" text="课程编号" />
                <TableColumn fx:id="coursename" prefWidth="77.5" text="课程名" />
                  <TableColumn fx:id="time" prefWidth="77.5" text="上课时间" />
                  <TableColumn fx:id="classroom" prefWidth="77.5" text="教室" />
                  <TableColumn fx:id="tcid" prefWidth="77.5" text="教师工号" />
                  <TableColumn fx:id="tcname" prefWidth="77.5" text="教师" />
              </columns>
            </TableView>
         </center>
         <right>
            <VBox prefHeight="400.0" prefWidth="245.0" spacing="6.0" BorderPane.alignment="CENTER">
               <children>
                  <Label prefHeight="35.0" prefWidth="179.0" text="              操作区">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label prefHeight="15.0" prefWidth="69.0" text="添加课程：" />
                  <HBox prefHeight="34.0" prefWidth="235.0" spacing="12.0">
                     <children>
                        <Label text="课程编号" />
                        <TextField fx:id="inputcouid" />
                     </children>
                  </HBox>
                  <HBox prefHeight="34.0" prefWidth="235.0" spacing="12.0">
                     <children>
                        <Label text="课程名：" />
                        <TextField fx:id="inputcouname" />
                     </children>
                  </HBox>
                  <HBox layoutX="35.0" layoutY="120.0" prefHeight="34.0" prefWidth="235.0">
                     <children>
                        <Label text="上课时间：" />
                        <TextField fx:id="inputtime" />
                     </children>
                  </HBox>
                  <HBox layoutX="35.0" layoutY="367.0" prefHeight="34.0" prefWidth="235.0" spacing="23.0">
                     <children>
                        <Label text="教室：" />
                        <TextField fx:id="inputclassroom" />
                     </children>
                  </HBox>
                  <HBox layoutX="35.0" layoutY="381.0" prefHeight="34.0" prefWidth="241.0">
                     <children>
                        <Label text="教师工号：" />
                        <TextField fx:id="inputtcid" />
                     </children>
                  </HBox>
                  <HBox layoutX="20.0" layoutY="260.0" prefHeight="34.0" prefWidth="241.0">
                     <children>
                        <Label text="教师姓名：" />
                        <TextField fx:id="inputtcname" />
                     </children>
                  </HBox>
                  <Button fx:id="addbtn" mnemonicParsing="false" onAction="#add" prefHeight="23.0" prefWidth="64.0" text="添加" />
                  <Button fx:id="delbtn" mnemonicParsing="false" onAction="#del" prefHeight="23.0" prefWidth="64.0" text="删除" />
                  <Button fx:id="refreshbtn" mnemonicParsing="false" onAction="#refresh" prefHeight="23.0" prefWidth="64.0" text="刷新" />
               </children>
               <padding>
                  <Insets left="10.0" />
               </padding>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
