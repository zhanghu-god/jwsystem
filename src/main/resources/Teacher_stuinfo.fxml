<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Teacher_stuinfoCon">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <TableView fx:id="tableview" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="coursename" prefWidth="75.0" text="课程" />
                <TableColumn fx:id="stuid" prefWidth="75.0" text="学号" />
                  <TableColumn fx:id="stuname" prefWidth="75.0" text="名称" />
                  <TableColumn fx:id="score" prefWidth="75.0" text="成绩" />
              </columns>
            </TableView>
         </center>
         <right>
            <VBox prefHeight="400.0" prefWidth="247.0" spacing="10.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label prefHeight="76.0" prefWidth="262.0" text="             修改成绩" textAlignment="CENTER">
                           <font>
                              <Font size="21.0" />
                           </font></Label>
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="10.0" prefHeight="19.0" prefWidth="247.0">
                     <children>
                        <Label text="输入修改后的成绩：">
                           <HBox.margin>
                              <Insets left="20.0" />
                           </HBox.margin></Label>
                     </children>
                  </HBox>
                  <TextField fx:id="newmark" prefHeight="23.0" prefWidth="198.0">
                     <VBox.margin>
                        <Insets left="50.0" right="50.0" />
                     </VBox.margin></TextField>
                  <Button fx:id="confirm" mnemonicParsing="false" onAction="#change" text="确认修改">
                     <VBox.margin>
                        <Insets left="133.0" top="10.0" />
                     </VBox.margin></Button>
               </children>
            </VBox>
         </right>
      </BorderPane>
   </children>
</AnchorPane>
