<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.controller.Admin_teainfoController">
    <children>
        <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <center>
                <TableView fx:id="tableview" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
                    <columns>
                        <TableColumn fx:id="teaid" prefWidth="75.0" text="工号" />
                        <TableColumn fx:id="teaname" prefWidth="75.0" text="姓名" />
                        <TableColumn fx:id="password" prefWidth="75.0" text="密码" visible="false" />
                    </columns>
                </TableView>
            </center>
            <right>
                <VBox prefHeight="400.0" prefWidth="250.0" spacing="20.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label prefHeight="35.0" prefWidth="179.0" text="              操作区">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <Label text="添加/删除教师：" />
                        <HBox prefHeight="45.0" prefWidth="241.0" spacing="20.0">
                            <children>
                                <Label text="工号" />
                                <TextField fx:id="inputid" />
                            </children>
                        </HBox>
                        <HBox prefHeight="40.0" prefWidth="189.0" spacing="20.0">
                            <children>
                                <Label text="姓名" />
                                <TextField fx:id="inputname" />
                            </children>
                        </HBox>
                        <Button fx:id="addbtn" mnemonicParsing="false" onAction="#add" prefHeight="23.0" prefWidth="64.0" text="添加" />
                        <Button fx:id="delbtn" mnemonicParsing="false" onAction="#del" prefHeight="23.0" prefWidth="64.0" text="删除" />
                        <Button fx:id="refreshbtn" mnemonicParsing="false" onAction="#refresh" prefHeight="23.0" prefWidth="64.0" text="刷新" />
                    </children>
                    <padding>
                        <Insets left="25.0" top="20.0" />
                    </padding>
                </VBox>
            </right>
        </BorderPane>
    </children>
</AnchorPane>
